<?xml version="1.0" encoding="UTF-8"?>
<server description="WebSphere Cafe Liberty Server">

    <!-- Enable Liberty features -->
    <featureManager>
        <feature>jaxrs-2.1</feature>
        <feature>jpa-2.2</feature>
        <feature>cdi-2.0</feature>
        <feature>jsf-2.3</feature>
        <feature>ejbLite-3.2</feature>
        <feature>beanValidation-2.0</feature>
        <feature>jdbc-4.2</feature>
        <feature>jndi-1.0</feature>
        <feature>servlet-4.0</feature>
        <feature>mpConfig-3.0</feature>
        <feature>mpHealth-4.0</feature>
        <feature>mpMetrics-4.0</feature>
    </featureManager>

    <!-- HTTP Endpoint -->
    <httpEndpoint id="defaultHttpEndpoint"
                  httpPort="${default.http.port}"
                  httpsPort="${default.https.port}" />

    <!-- Web Application -->
    <webApplication location="websphere-cafe.war" 
                    contextRoot="/websphere-cafe" 
                    id="websphere-cafe"/>

    <!-- Database Configuration -->
    <dataSource id="DefaultDataSource" jndiName="jdbc/WebSphereCafeDB">
        <jdbcDriver>
            <library>
                <fileset dir="${shared.config.dir}/lib" includes="*.jar"/>
            </library>
        </jdbcDriver>
        <properties.postgresql serverName="${DB_SERVER:localhost}"
                              portNumber="${DB_PORT:5432}"
                              databaseName="${DB_NAME:cafedb}"
                              user="${DB_USER:cafe}"
                              password="${DB_PASSWORD:cafe123}"/>
    </dataSource>

    <!-- Logging -->
    <logging traceSpecification="*=info" maxFileSize="20" maxFiles="10" />

    <!-- Basic Registry for development -->
    <basicRegistry id="basic" realm="BasicRealm">
        <user name="admin" password="admin" />
    </basicRegistry>

    <!-- Admin Center (optional for development) -->
    <keyStore id="defaultKeyStore" password="Liberty" />

</server>